---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextLinks from '../components/NextLinks.astro';
import { site, experience, education, fill, hats, studied } from '../data/site';

const sections = [
  { heading: 'Experience', items: experience },
  { heading: 'Education', items: education },
];
---
<Base title="Experience" description="Work experience and education.">
  <PageHero title="Experience" kicker="Where I've been, where I'm heading" art="experience">
    <p class="lede">An internship at Lazard Asset Management alongside a Bachelor of Commerce at Macquarie University.</p>
    {site.resumePdf && <p class="dl"><a class="btn ghost" href={site.resumePdf}>Download résumé (PDF)</a></p>}
  </PageHero>
  <section class="section first">
    <div class="wrap">
      <section class="block">
        <h2>One internship, three hats</h2>
        <p class="sub">My title at Lazard was intern. The work spanned three roles, with some hands-on automation and app building along the way.</p>
        <ul class="hats cycle">
          {hats.map((h) => <li><b>{h.title}</b><span>{h.body}</span></li>)}
        </ul>
      </section>

      {sections.map((s) => (
        <section class="block">
          <h2>{s.heading}</h2>
          <ol class="timeline">
            {s.items.map((item) => (
              <li>
                <div class="when" set:html={fill(item.period)} />
                <div>
                  <h3>{item.title}</h3>
                  <p class="org" set:html={fill(item.org)} />
                  <ul>{item.points.map((pt) => <li set:html={fill(pt)} />)}</ul>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <section class="block">
        <h2>What I studied</h2>
        <div class="studied-grid">
          <div class="st-box major">
            <h3>Major</h3>
            <ul class="tags">{studied.major.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="st-box found">
            <h3>Foundations</h3>
            <p>A basic, working understanding of:</p>
            <ul class="tags">{studied.foundations.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </section>
    </div>
  </section>
  <NextLinks current="/resume" />
</Base>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .first { padding-top: 1rem; }
  .dl { margin-top: 1.5rem; }
  .block { margin-top: 3rem; }
  .sub { color: var(--muted); }
  .hats { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .hats li { background: var(--surface); border-radius: 16px; padding: 1.1rem 1.2rem; box-shadow: 0 0 0 1px var(--ring); border-top: 4px solid var(--c); background: linear-gradient(180deg, var(--cs) 0, var(--surface) 75%); }
  .hats b { display: block; margin-bottom: 0.3rem; font-size: 1.05rem; }
  .hats span { color: var(--muted); font-size: 0.93rem; }
  .studied-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .st-box { border-radius: 16px; padding: 1.1rem 1.25rem; }
  .st-box h3 { font-size: 1.05rem; margin-bottom: 0.5rem; }
  .st-box p { color: var(--muted); font-size: 0.92rem; margin-bottom: 0.6rem; }
  .st-box.major { background: var(--accent-soft); }
  .st-box.found { background: var(--amber-soft); }
  .st-box.found .tags li { background: var(--amber-tag); color: var(--amber-ink); }
  @media (max-width: 36rem) { .studied-grid { grid-template-columns: 1fr; } }
  .res { list-style: none; margin: 1rem 0 0; padding: 1.3rem clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr)); gap: 1.25rem; background: var(--night); border-radius: 20px; }
  .res b { display: block; font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 800; letter-spacing: -0.04em; white-space: nowrap; background: linear-gradient(100deg, #5fd0d9 10%, #f5f5f7 85%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .res span { color: var(--night-muted); font-size: 0.85rem; }
  @media (max-width: 60rem) {
    .hats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .res { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .res li:first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 36rem) { .hats { grid-template-columns: 1fr; } }
  .block h2 { font-size: var(--step-2); }
  .timeline { list-style: none; padding: 0; margin: 1rem 0 0; }
  .timeline > li {
    display: grid; grid-template-columns: 12rem 1fr; gap: 0.5rem 2rem;
    border-top: 1px solid var(--line); padding: 1.5rem 0;
  }
  .when { color: var(--muted); font-weight: 500; }
  .timeline h3 { margin-bottom: 0.2rem; }
  .org { color: var(--accent); font-weight: 500; margin-bottom: 0.75rem; }
  .timeline ul { padding-left: 1.1rem; margin: 0; }
  .timeline ul li { margin-bottom: 0.4rem; }
  @media (max-width: 40rem) {
    .timeline > li { grid-template-columns: 1fr; }
  }
</style>
