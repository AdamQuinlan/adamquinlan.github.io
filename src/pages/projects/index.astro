---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import PageHero from '../../components/PageHero.astro';
import NextLinks from '../../components/NextLinks.astro';
import { projects } from '../../data/site';
---
<Base title="Projects" description="Automation and AI app projects from my internship at Lazard Asset Management.">
  <PageHero title="Projects" kicker="Built at Lazard Asset Management" art="projects">
    <p class="lede">Automations and AI tools I've built, and the business problems behind them.</p>
  </PageHero>
  <section class="section">
    <div class="wrap">
      <ProjectList items={projects} />
      <p class="more">
        Alongside these, I run the monthly client reports and handle ad hoc data requests for the business.
      </p>
    </div>
  </section>
  <NextLinks current="/projects" />
</Base>

<style>
  .more { color: var(--muted); margin-top: 2rem; max-width: 60ch; }
</style>
