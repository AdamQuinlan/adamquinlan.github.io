---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextLinks from '../components/NextLinks.astro';
import { site, skills, fill, facts, principles, toolkit, interests } from '../data/site';

// Small line icons for each skill group.
const icons: Record<string, string> = {
  'Data and automation': '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M3 14h18M9 4v16"/>',
  'Currently learning': '<path d="M4 19V6a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2"/><path d="M8 8h7M8 12h5"/>',
  'AI': '<circle cx="12" cy="12" r="3"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="12" cy="20" r="2"/><path d="M6.5 6.5 10 10M17.5 6.5 14 10M12 15v3"/>',
  'Platforms': '<path d="M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z"/>',
  'Business': '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12h18"/>',
};
---
<Base title="About" description={site.intro}>
  <PageHero title="About me" kicker="Data meets business" art="about">
    <p class="lede">{site.intro}</p>
  </PageHero>

  <section class="section facts-sec">
    <div class="wrap">
      <dl class="facts">
        {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>Two sides, one job</h2>
      </div>
      <div class="story">
        <h3>The data and systems side</h3>
        <p>
          At Lazard Asset Management I work across business analysis, data analysis and business systems.
          Day to day that means talking to teams about what they need, handling ad hoc requests, and
          building the Excel master files that turn raw data into client reports. This year it also
          included an AI checking app built with Claude Code, now used by the product and sales teams,
          and wireframing ideas that the rest of my team went on to build.
        </p>
        <h3>The business side</h3>
        <p>
          My Bachelor of Commerce, majoring in international business, taught me how organisations actually
          operate: how decisions get made, how teams are managed, and how processes run across markets.
          That context helps me design data systems around real business questions rather than just tables.
        </p>
        <h3>The team side</h3>
        <p>
          My capstone and PACE projects put me in teams from different majors, with real organisations as
          partners. In both I ended up leading: working out what each person was best at, steering them
          toward it, keeping everyone to schedule, and keeping our partner informed and on side.
          <a href="/resume#uni">See my university projects</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How I work</h2>
      <ol class="principles cycle">
        {principles.map((p, i) => (
          <li><span class="n">{i + 1}</span><h3>{p.title}</h3><p>{p.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>My toolkit, and where I've used it</h2>
      <table class="toolkit">
        <thead><tr><th scope="col">Tool</th><th scope="col">Where I've used it</th></tr></thead>
        <tbody>{toolkit.map((t) => <tr><th scope="row">{t.tool}</th><td>{t.use}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Skills</h2>
      <dl class="skills cycle">
        {Object.entries(skills).map(([group, list]) => (
          <div>
            <dt><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[group] ?? ''} />{group}</dt>
            <dd><ul class="tags">{list.map((s) => <li set:html={fill(s)} />)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Outside work</h2>
      <p class="sub-int">When I'm not building things, you'll find me doing one of these.</p>
      <ul class="interests cycle">
        {interests.map((i) => (
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={i.icon} /><span>{i.name}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <NextLinks current="/about" />
</Base>

<style>
  .facts-sec { padding-top: clamp(2rem, 5vw, 3rem); padding-bottom: clamp(2rem, 5vw, 3rem); }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-radius: 18px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); background: var(--surface); }
  .facts > div { padding: 1rem 1.25rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts > div:nth-child(3n) { border-right: 0; }
  .facts > div:nth-last-child(-n + 3) { border-bottom: 0; }
  .facts dt { font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .facts dd { margin: 0.15rem 0 0; font-weight: 550; }
  .principles { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .principles li { background: linear-gradient(180deg, var(--cs) 0, var(--surface) 70%); border-radius: 18px; padding: 1.3rem; box-shadow: 0 0 0 1px var(--ring); }
  .principles .n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--c); color: #fff; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.8rem; }
  .principles h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .principles p { color: var(--muted); font-size: 0.95rem; margin: 0; }
  .sub-int { color: var(--muted); }
  .interests { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .interests li { display: flex; align-items: center; gap: 0.8rem; padding: 1rem 1.15rem; border-radius: 16px; background: var(--cs); font-weight: 650; }
  .interests svg { width: 40px; height: 40px; flex: none; padding: 8px; border-radius: 12px; background: var(--surface); fill: none; stroke: var(--c); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 52rem) { .interests { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .toolkit { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
  .toolkit th, .toolkit td { text-align: left; padding: 0.9rem 0.75rem 0.9rem 0; border-top: 1px solid var(--line); vertical-align: top; }
  .toolkit thead th { font-size: 0.8rem; color: var(--muted); font-weight: 600; border-top: 0; }
  .toolkit tbody th { width: 34%; font-weight: 600; }
  .toolkit td { color: var(--muted); }
  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem 4rem; }
  .story h3 { margin-top: 1.5rem; }
  .story h3:first-child { margin-top: 0; }
  .skills { display: grid; gap: 1.25rem; margin: 2rem 0 0; }
  .skills > div { display: grid; grid-template-columns: 13rem 1fr; gap: 1rem; align-items: baseline; border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .skills dt { font-weight: 600; display: flex; align-items: center; gap: 0.55rem; }
  .ic { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--c, var(--accent)); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .skills dd { margin: 0; }
  @media (max-width: 60rem) {
    .principles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 52rem) {
    .two, .skills > div { grid-template-columns: 1fr; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts > div { border-right: 1px solid var(--line) !important; border-bottom: 1px solid var(--line) !important; }
    .facts > div:nth-child(2n) { border-right: 0 !important; }
    .facts > div:nth-last-child(-n + 2) { border-bottom: 0 !important; }
  }
  @media (max-width: 36rem) {
    .principles { grid-template-columns: 1fr; }
    .toolkit tbody th { width: 40%; }
  }
</style>
