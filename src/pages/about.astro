---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, skills, fill } from '../data/site';

// Small line icons for each skill group.
const icons: Record<string, string> = {
  'Data and automation': '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M3 14h18M9 4v16"/>',
  'Currently learning': '<path d="M4 19V6a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2"/><path d="M8 8h7M8 12h5"/>',
  'AI': '<circle cx="12" cy="12" r="3"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="12" cy="20" r="2"/><path d="M6.5 6.5 10 10M17.5 6.5 14 10M12 15v3"/>',
  'Platforms': '<path d="M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z"/>',
  'Business': '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12h18"/>',
};
---
<Base title="About" description={site.intro}>
  <PageHero title="About me" kicker="Data meets business" art="about">
    <p class="lede">{site.intro}</p>
  </PageHero>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>Two sides, one job</h2>
      </div>
      <div class="story">
        <h3>The engineering side</h3>
        <p>
          In my internship I've moved between data engineering and analysis. I build the apps and
          automations that collect data from different systems, clean it up and get it to the people who rely on it.
        </p>
        <h3>The business side</h3>
        <p>
          My Bachelor of Commerce, majoring in international business, taught me how organisations actually
          operate: how decisions get made, how teams are managed, and how processes run across markets.
          That context helps me design data systems around real business questions rather than just tables.
        </p>
        <h3>How I work</h3>
        <p>
          I like to understand the process before I automate it, talk to the people who use the output,
          and keep pipelines simple enough that someone else can maintain them.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Skills</h2>
      <dl class="skills">
        {Object.entries(skills).map(([group, list]) => (
          <div>
            <dt><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[group] ?? ''} />{group}</dt>
            <dd><ul class="tags">{list.map((s) => <li set:html={fill(s)} />)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .intro h1 { max-width: 14ch; }
  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem 4rem; }
  .story h3 { margin-top: 1.5rem; }
  .story h3:first-child { margin-top: 0; }
  .skills { display: grid; gap: 1.25rem; margin: 2rem 0 0; }
  .skills > div { display: grid; grid-template-columns: 13rem 1fr; gap: 1rem; align-items: baseline; border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .skills dt { font-weight: 600; display: flex; align-items: center; gap: 0.55rem; }
  .ic { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .skills dd { margin: 0; }
  @media (max-width: 52rem) {
    .two, .skills > div { grid-template-columns: 1fr; }
  }
</style>
