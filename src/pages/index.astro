---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import '../styles/story.css';

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const bars = [42, 58, 51, 67, 74, 88];
const tiles = [
  { t: 'Accounting', x: -340, y: -220, r: -14 },
  { t: 'Finance', x: 120, y: -300, r: 9 },
  { t: 'Marketing', x: 380, y: -160, r: 16 },
  { t: 'Economics', x: 460, y: 60, r: -10 },
  { t: 'Culture', x: -420, y: 120, r: 12 },
  { t: 'People management', x: -160, y: 300, r: -8 },
  { t: 'Teamwork', x: 200, y: 320, r: 14 },
  { t: 'Communication', x: 420, y: 260, r: -16 },
];
const stations = ['Prototype', 'Development', 'Testing', 'Production'];
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <p class="hero-hi">{site.name}</p>
      <h1 class="hero-title">Data engineer.<br /><span class="dim">Business thinker.</span></h1>
      <p class="hero-sub">{site.headline}</p>
      <div class="hero-actions">
        <a class="btn" href="#automation">See how it works</a>
        <a class="btn ghost" href="/contact">Get in touch</a>
      </div>
    </div>
    <p class="scroll-cue" aria-hidden="true">Scroll</p>
  </section>

  <!-- Chapter 1: client report automation -->
  <section class="scene light" id="automation" data-scene data-steps="3" aria-label="Chapter 1: client report automation">
    <div class="pin">
      <div class="wrap pin-grid">
        <div class="caps">
          <p class="kicker">Client report automation</p>
          <div class="cap-stack">
            <div class="cap" data-at="0">
              <h2>It starts as raw data.</h2>
              <p>Exports from different systems, each with its own formats, gaps and duplicates. Not something you can send to a client.</p>
            </div>
            <div class="cap" data-at="1">
              <h2>Then it gets transformed.</h2>
              <p>The pipeline cleans, standardises and validates every row, so dates line up, duplicates disappear and missing values are caught.</p>
            </div>
            <div class="cap" data-at="2">
              <h2>And becomes a finished report.</h2>
              <p>The final client report is generated automatically, then the whole process runs again next month without anyone rebuilding it.</p>
            </div>
          </div>
        </div>

        <div class="stage">
          <div class="win">
            <div class="win-bar">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="win-titles">
                <span data-at="0">raw_export.csv</span>
                <span data-at="1">transform.py</span>
                <span data-at="2">Client report, March</span>
              </span>
            </div>
            <div class="win-body">
              <table class="data" data-until="1">
                <thead><tr><th>Client</th><th>Date</th><th>Revenue</th><th>Region</th></tr></thead>
                <tbody>
                  <tr>
                    <td class="fix" data-from="1"><span class="raw">ACME ltd</span><span class="cln">Acme Ltd</span></td>
                    <td class="fix" data-from="1"><span class="raw">03/02/26</span><span class="cln">2026-02-03</span></td>
                    <td class="fix" data-from="1"><span class="raw">12,400 </span><span class="cln">12400</span></td>
                    <td class="fix" data-from="1"><span class="raw">&nbsp;</span><span class="cln">APAC</span></td>
                  </tr>
                  <tr class="dup" data-from="1">
                    <td>Acme Ltd.</td><td>2026-02-03</td><td>12400</td><td>APAC</td>
                  </tr>
                  <tr>
                    <td>Northwind</td>
                    <td class="fix" data-from="1"><span class="raw">Feb 5</span><span class="cln">2026-02-05</span></td>
                    <td class="fix" data-from="1"><span class="raw">n/a</span><span class="cln">9310</span></td>
                    <td>EMEA</td>
                  </tr>
                  <tr>
                    <td>Globex</td><td>2026-02-07</td>
                    <td class="fix" data-from="1"><span class="raw">8,950</span><span class="cln">8950</span></td>
                    <td class="fix" data-from="1"><span class="raw">apac</span><span class="cln">APAC</span></td>
                  </tr>
                  <tr>
                    <td>Initech</td>
                    <td class="fix" data-from="1"><span class="raw">&nbsp;</span><span class="cln">2026-02-11</span></td>
                    <td>15200</td><td>AMER</td>
                  </tr>
                </tbody>
              </table>

              <div class="report" data-from="2">
                <div class="report-head">
                  <div>
                    <strong>Monthly client report</strong>
                    <span>March 2026</span>
                  </div>
                  <span class="auto">Generated automatically</span>
                </div>
                <div class="kpis">
                  <div><b>4</b><span>Clients</span></div>
                  <div><b>45.9k</b><span>Revenue</span></div>
                  <div><b>0</b><span>Errors</span></div>
                </div>
                <div class="bars" aria-hidden="true">
                  {bars.map((h, i) => <i style={`--v:${h}%; --d:${i * 70}ms`}></i>)}
                </div>
              </div>
            </div>
          </div>

          <div class="months" aria-label="Runs every month">
            <span class="months-label">Runs every month</span>
            <ol>
              {months.map((m, i) => <li data-p={(0.7 + i * 0.022).toFixed(3)}>{m}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 2: AI report checker -->
  <section class="scene dark" id="ai-checker" data-scene data-steps="4" aria-label="Chapter 2: AI report-checking app">
    <div class="pin">
      <div class="wrap pin-grid">
        <div class="caps">
          <p class="kicker">AI report checker</p>
          <div class="cap-stack">
            <div class="cap" data-at="0">
              <h2>Every report needed checking.</h2>
              <p>Before a client report goes out, the product and sales teams have to check it. By hand, that took about an hour each.</p>
            </div>
            <div class="cap" data-at="1">
              <h2>So I gave it three reviewers.</h2>
              <p>Three separate AI agents read the same report, and each one runs its own individual checks.</p>
            </div>
            <div class="cap" data-at="2">
              <h2>They compare notes.</h2>
              <p>Before answering, the agents discuss their findings with each other, confirming issues and ruling out false alarms.</p>
            </div>
            <div class="cap" data-at="3">
              <h2>You get one clear verdict.</h2>
              <p>The app returns a finalised outcome: what's fine, what needs a look and what needs fixing, so the team goes straight to what matters.</p>
            </div>
          </div>
        </div>

        <div class="stage">
          <div class="agents">
            <svg class="links" viewBox="0 0 600 500" preserveAspectRatio="none" aria-hidden="true">
              <g class="scan" data-from="1">
                <line x1="110" y1="95" x2="250" y2="210" />
                <line x1="490" y1="95" x2="350" y2="210" />
                <line x1="300" y1="420" x2="300" y2="330" />
              </g>
              <g class="talk" data-from="2">
                <line x1="110" y1="95" x2="490" y2="95" />
                <line x1="490" y1="95" x2="300" y2="420" />
                <line x1="300" y1="420" x2="110" y2="95" />
              </g>
            </svg>

            <div class="doc" data-until="2">
              <span class="doc-title">Client report</span>
              <i></i><i></i><i class="short"></i><i></i><i></i><i class="short"></i>
            </div>

            <div class="agent a1" data-from="1"><span class="orb">1</span><span>Agent 1</span></div>
            <div class="agent a2" data-from="1"><span class="orb">2</span><span>Agent 2</span></div>
            <div class="agent a3" data-from="1"><span class="orb">3</span><span>Agent 3</span></div>

            <p class="bubble b1" data-at="2">Totals on page 3 don't reconcile.</p>
            <p class="bubble b2" data-at="2">Confirmed. Source has the right figure.</p>
            <p class="bubble b3" data-at="2">Fee wording checks out.</p>

            <div class="verdict" data-from="3">
              <strong>Check complete</strong>
              <ul>
                <li class="ok"><span></span>Fine: 14 checks passed</li>
                <li class="look"><span></span>Look at: fee wording on page 2</li>
                <li class="fixit"><span></span>Fix: totals mismatch on page 3</li>
              </ul>
            </div>
          </div>
          <p class="note">Illustrative example</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 3: time saved -->
  <section class="scene dark stat" data-scene data-steps="1" aria-label="Result: checking time cut from about an hour to about five minutes">
    <div class="pin">
      <div class="wrap stat-wrap">
        <p class="kicker">The result</p>
        <p class="big"><span data-count-from="60" data-count-to="5">5</span> min</p>
        <p class="stat-sub">to check a client report, down from about an hour.</p>
        <div class="timebar" aria-hidden="true"><span></span></div>
        <div class="timebar-labels" aria-hidden="true"><span>Before: ~60 min</span><span>After: ~5 min</span></div>
      </div>
    </div>
  </section>

  <!-- Chapter 4: development to production -->
  <section class="scene light" data-scene data-steps="4" aria-label="Chapter 3: from prototype to production">
    <div class="pin">
      <div class="wrap ship">
        <p class="kicker">Built to ship</p>
        <h2 class="ship-title">From an idea to an app people use every day.</h2>
        <p class="ship-sub">I took the checker through development and into production, where the product and sales teams rely on it for their checks.</p>
        <div class="track">
          <div class="rail"><span></span></div>
          <ol>
            {stations.map((s, i) => <li data-from={i}><i></i><span>{s}</span></li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 5: Commerce degree -->
  <section class="scene light biz" data-scene data-steps="1" aria-label="Chapter 4: Bachelor of Commerce">
    <div class="pin">
      <div class="wrap biz-wrap">
        <div class="biz-copy">
          <p class="kicker">The business side</p>
          <h2>I know what the data is for.</h2>
          <p>My Bachelor of Commerce, majoring in international business, gave me a working understanding of how businesses run, from the numbers to the people.</p>
        </div>
        <ul class="tiles">
          {tiles.map((t) => <li style={`--x:${t.x}; --y:${t.y}; --r:${t.r}`}>{t.t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="close">
    <div class="wrap">
      <h2>Raw data in.<br />Checked results out.</h2>
      <p>I'm looking for {site.openTo.toLowerCase()}. I'd like to hear what your team is building.</p>
      <div class="hero-actions center">
        <a class="btn light" href="/contact">Get in touch</a>
        <a class="btn ghost light" href="/projects">Read the project write-ups</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Drives every pinned chapter from the scroll position.
  // --p is the chapter's progress (0 to 1); --pe is an eased version used for motion.
  const scenes = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  const darkZones = Array.from(document.querySelectorAll<HTMLElement>('.scene.dark, .close'));

  function update() {
    const vh = window.innerHeight;
    // Darken the menu bar while a black chapter sits underneath it.
    const navDark = darkZones.some((el) => {
      const r = el.getBoundingClientRect();
      return r.top <= 30 && r.bottom > 30;
    });
    document.documentElement.classList.toggle('nav-dark', navDark);
    for (const scene of scenes) {
      const rect = scene.getBoundingClientRect();
      const span = rect.height - vh;
      const p = span > 0 ? clamp(-rect.top / span) : 1;
      const pe = clamp((p - 0.08) / 0.62);
      scene.style.setProperty('--p', p.toFixed(4));
      scene.style.setProperty('--pe', pe.toFixed(4));

      const steps = Number(scene.dataset.steps || 1);
      const step = Math.min(steps - 1, Math.floor(p * steps));
      scene.dataset.step = String(step);

      scene.querySelectorAll<HTMLElement>('[data-at]').forEach((el) =>
        el.classList.toggle('on', Number(el.dataset.at) === step));
      scene.querySelectorAll<HTMLElement>('[data-from]').forEach((el) =>
        el.classList.toggle('on', step >= Number(el.dataset.from)));
      scene.querySelectorAll<HTMLElement>('[data-until]').forEach((el) =>
        el.classList.toggle('on', step <= Number(el.dataset.until)));
      scene.querySelectorAll<HTMLElement>('[data-p]').forEach((el) =>
        el.classList.toggle('on', p >= Number(el.dataset.p)));
      scene.querySelectorAll<HTMLElement>('[data-count-from]').forEach((el) => {
        const from = Number(el.dataset.countFrom);
        const to = Number(el.dataset.countTo);
        el.textContent = String(Math.round(from + (to - from) * pe));
      });
    }
  }

  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; update(); });
  };
  document.documentElement.classList.add('js');
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
</script>
