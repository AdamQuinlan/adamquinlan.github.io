<script>
  // Each chapter plays its animation automatically while it is on screen.
  // Nothing is pinned, so visitors can scroll past at any point.
  // A small control under each multi-step chapter lets people pause or jump to a step.
  const root = document.documentElement;
  root.classList.add('js');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scenes = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));
  const darkZones = Array.from(document.querySelectorAll<HTMLElement>('.scene.dark, .close'));

  type State = { el: HTMLElement; steps: number; step: number; ms: number; timer?: number; playing: boolean; visible: boolean; intro: boolean; dots: HTMLButtonElement[]; toggle?: HTMLButtonElement };

  function render(st: State) {
    const { el, step } = st;
    el.dataset.step = String(step);
    el.querySelectorAll<HTMLElement>('[data-at]').forEach((n) => n.classList.toggle('on', Number(n.dataset.at) === step));
    el.querySelectorAll<HTMLElement>('[data-from]').forEach((n) => n.classList.toggle('on', step >= Number(n.dataset.from)));
    st.dots.forEach((d, i) => {
      d.classList.toggle('on', i === step);
      d.setAttribute('aria-current', i === step ? 'step' : 'false');
    });
    // restart the progress fill on the active dot
    const active = st.dots[step];
    if (active) { active.classList.remove('run'); void active.offsetWidth; if (st.playing) active.classList.add('run'); }
  }

  function schedule(st: State) {
    window.clearTimeout(st.timer);
    if (!st.playing || !st.visible || st.steps < 2) return;
    const last = st.step === st.steps - 1;
    st.timer = window.setTimeout(() => {
      st.step = last ? 0 : st.step + 1;
      render(st);
      schedule(st);
    }, last ? st.ms * 1.8 : st.ms);
  }

  function setPlaying(st: State, on: boolean) {
    st.playing = on;
    st.el.classList.toggle('paused', !on);
    if (st.toggle) {
      st.toggle.setAttribute('aria-label', on ? 'Pause animation' : 'Play animation');
      st.toggle.dataset.state = on ? 'playing' : 'paused';
    }
    render(st);
    schedule(st);
  }

  // One-off entrance tween for counters, bars and drawn lines (--pe goes 0 to 1).
  function playIntro(st: State) {
    if (st.intro) return;
    st.intro = true;
    const counters = Array.from(st.el.querySelectorAll<HTMLElement>('[data-count-from]'));
    const setPe = (pe: number) => {
      st.el.style.setProperty('--pe', pe.toFixed(4));
      counters.forEach((c) => {
        const from = Number(c.dataset.countFrom), to = Number(c.dataset.countTo);
        c.textContent = String(Math.round(from + (to - from) * pe));
      });
    };
    if (reduce) { setPe(1); return; }
    const start = performance.now(), dur = 1600;
    const tick = (t: number) => {
      const x = Math.min(1, (t - start) / dur);
      setPe(1 - Math.pow(1 - x, 3));
      if (x < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const states: State[] = scenes.map((el) => {
    const steps = Number(el.dataset.steps || 1);
    const st: State = { el, steps, step: 0, ms: Number(el.dataset.ms || 3000), playing: !reduce, visible: false, intro: false, dots: [] };
    el.style.setProperty('--pe', reduce ? '1' : '0');

    if (steps > 1) {
      const bar = document.createElement('div');
      bar.className = 'stepper';
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'st-toggle';
      toggle.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M8 5v14M16 5v14"/><path class="i-play" d="M8 5l11 7-11 7z"/></svg>';
      toggle.addEventListener('click', () => setPlaying(st, !st.playing));
      bar.appendChild(toggle);
      st.toggle = toggle;
      for (let i = 0; i < steps; i++) {
        const label = el.querySelector(`[data-at="${i}"] h2, [data-at="${i}"] h3`)?.textContent?.trim() || `Step ${i + 1}`;
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'st-dot';
        dot.setAttribute('aria-label', `Step ${i + 1} of ${steps}: ${label}`);
        dot.innerHTML = '<span></span>';
        dot.addEventListener('click', () => { st.step = i; setPlaying(st, false); });
        bar.appendChild(dot);
        st.dots.push(dot);
      }
      el.style.setProperty('--ms', `${st.ms}ms`);
      (el.querySelector('.caps') ?? el.querySelector('.pin > .wrap'))?.appendChild(bar);
    }
    setPlaying(st, st.playing);
    return st;
  });

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const st = states.find((s) => s.el === e.target);
      if (!st) continue;
      const nowVisible = e.isIntersecting && e.intersectionRatio >= 0.3;
      if (nowVisible && !st.visible) playIntro(st);
      st.visible = nowVisible;
      schedule(st);
    }
  }, { threshold: [0, 0.3, 0.6] });
  states.forEach((st) => io.observe(st.el));

  // Darken the menu bar while a black section sits underneath it.
  let queued = false;
  const navCheck = () => {
    queued = false;
    const dark = darkZones.some((el) => { const r = el.getBoundingClientRect(); return r.top <= 30 && r.bottom > 30; });
    root.classList.toggle('nav-dark', dark);
  };
  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(navCheck); } }, { passive: true });
  navCheck();
</script>
