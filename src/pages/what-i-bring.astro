---
import Base from '../layouts/Base.astro';
import NextLinks from '../components/NextLinks.astro';
import { site, proof, offers, startPlan } from '../data/site';
---
<Base title="What I bring" description="What I can do for your team: find where time is lost, automate the repetitive work, and put AI to practical use.">
  <section class="pitch-hero">
    <div class="wrap">
      <p class="kicker">What I bring</p>
      <h1>What I can do for your team.</h1>
      <p class="lede">
        You get someone who learns your business quickly, finds where time is being lost,
        and builds practical tools that give it back, with results you can measure.
      </p>
    </div>
  </section>

  <section class="proof-band">
    <div class="wrap">
      <p class="band-title">Results from my internship at Lazard Asset Management</p>
      <ul class="proof">
        {proof.map((p) => (
          <li><b>{p.value}</b><span>{p.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How I can help</h2>
      <div class="offers cycle">
        {offers.map((o) => (
          <article class="offer">
            <h3>{o.title}</h3>
            <p>{o.body}</p>
            <p class="offer-proof"><b>Proof:</b> {o.proof}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How I'd start in your team</h2>
      <ol class="plan cycle">
        {startPlan.map((s) => (
          <li>
            <span class="when">{s.when}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pitch-close">
    <div class="wrap">
      <h2>Let's talk about your team's slowest process.</h2>
      <p>I'm looking for {site.openTo.toLowerCase()}, available from {site.available}. {site.workRights}.</p>
      <div class="actions">
        <a class="btn light" href="/contact">Get in touch</a>
        {site.linkedin && <a class="btn ghost light" href={site.linkedin}>Connect on LinkedIn</a>}
        {site.resumePdf && <a class="btn ghost light" href={site.resumePdf} download>Download my CV</a>}
      </div>
    </div>
  </section>
  <NextLinks current="/what-i-bring" />
</Base>

<style>
  .kicker { color: var(--accent); font-weight: 650; font-size: 1.05rem; margin-bottom: 0.75rem; }
  .pitch-hero {
    padding: clamp(4rem, 10vw, 7rem) 0 clamp(2.5rem, 6vw, 4rem); text-align: center;
    background-image:
      radial-gradient(ellipse at center, rgba(var(--bg-rgb), 0.2) 0%, var(--bg) 72%),
      linear-gradient(rgba(11, 122, 133, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 122, 133, 0.08) 1px, transparent 1px);
    background-size: 100% 100%, 28px 28px, 28px 28px;
  }
  .pitch-hero h1 { font-size: clamp(2.6rem, 7vw, 5.4rem); font-weight: 800; letter-spacing: -0.045em; max-width: 14ch; margin-left: auto; margin-right: auto; }
  .pitch-hero .lede { margin: 0 auto; max-width: 46ch; font-size: clamp(1.1rem, 2vw, 1.35rem); }

  .proof-band { background: var(--night); color: var(--night-ink); padding: clamp(2.5rem, 6vw, 4rem) 0; }
  .band-title { color: var(--night-muted); text-align: center; margin: 0 auto 2rem; font-size: 0.95rem; }
  .proof { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1.45fr) repeat(3, minmax(0, 1fr)); gap: 2rem 1.5rem; text-align: center; }
  .proof b {
    display: block; font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.1; white-space: nowrap;
    background: linear-gradient(100deg, #5fd0d9 10%, #f5f5f7 85%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .proof span { display: block; color: var(--night-muted); font-size: 0.92rem; margin: 0.5rem auto 0; max-width: 22ch; }

  h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .offers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2rem; }
  .offer {
    background: var(--surface); border-radius: 18px; padding: 1.5rem 1.5rem 1.4rem;
    box-shadow: 0 0 0 1px var(--ring);
    display: flex; flex-direction: column;
  }
  .offer h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .offer p { color: var(--muted); font-size: 0.98rem; }
  .offer .offer-proof {
    margin: auto 0 0; padding-top: 0.9rem; border-top: 1px solid var(--line);
    color: var(--ink); font-size: 0.9rem;
  }
  .offer-proof b { color: var(--c); }
  .offer { border-top: 4px solid var(--c); }

  .plan { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; counter-reset: plan; }
  .plan li { border-top: 3px solid var(--c); padding-top: 1rem; }
  .when { display: block; color: var(--c); font-weight: 650; margin-bottom: 0.3rem; }
  .plan h3 { font-size: 1.35rem; margin-bottom: 0.4rem; }
  .plan p { color: var(--muted); margin: 0; }

  .pitch-close { background: var(--night); color: var(--night-ink); text-align: center; padding: clamp(5rem, 12vw, 8rem) 0; }
  .pitch-close h2 { font-size: clamp(2.2rem, 5.5vw, 4.4rem); font-weight: 800; letter-spacing: -0.045em; max-width: 18ch; margin-left: auto; margin-right: auto; }
  .pitch-close p { color: var(--night-muted); margin: 0 auto; font-size: 1.15rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem; }
  .btn.light { background: #f5f5f7; color: #000; }
  .btn.light:hover { background: var(--night-accent); }
  .btn.ghost.light { background: transparent; color: #f5f5f7; box-shadow: inset 0 0 0 1.5px #f5f5f7; }

  @media (max-width: 60rem) {
    .offers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof li:first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) {
    .offers, .plan { grid-template-columns: 1fr; }
  }
</style>
