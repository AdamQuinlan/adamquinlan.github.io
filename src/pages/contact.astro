---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextLinks from '../components/NextLinks.astro';
import { site, fill } from '../data/site';

const channels = [
  site.email && { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  site.linkedin && { label: 'LinkedIn', value: 'Connect on LinkedIn', href: site.linkedin },
].filter(Boolean) as { label: string; value: string; href: string }[];
---
<Base title="Contact" description={`Get in touch with ${site.name}.`}>
  <PageHero title="Let's talk" kicker="Get in touch" art="contact">
    <p class="lede">
      I'm looking for {site.openTo.toLowerCase()}. Recruiters, hiring managers and fellow
      data people are all welcome to reach out.
    </p>
  </PageHero>
  <section class="section">
    <div class="wrap">
      <dl class="channels">
        {channels.map((c) => (
          <div>
            <dt>{c.label}</dt>
            <dd><a href={c.href}>{c.value}</a></dd>
          </div>
        ))}
        <div>
          <dt>Based in</dt>
          <dd set:html={fill(site.location)} />
        </div>
      </dl>
      <div class="cta-row">
        <a class="btn" href={`mailto:${site.email}?subject=Hi%20Adam`}>Email me</a>
        <a class="btn ghost" href={site.linkedin}>Connect on LinkedIn</a>
      </div>
    </div>
  </section>
  <NextLinks current="/contact" />
</Base>

<style>
  .channels { margin: 0; max-width: 40rem; }
  .channels > div {
    display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem;
    border-top: 1px solid var(--line); padding: 1.1rem 0;
  }
  .channels > div:last-child { border-bottom: 1px solid var(--line); }
  dt { font-weight: 600; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .note { color: var(--muted); margin-top: 1rem; font-size: 0.95rem; }
  dd { margin: 0; font-size: var(--step-1); overflow-wrap: anywhere; }
</style>
