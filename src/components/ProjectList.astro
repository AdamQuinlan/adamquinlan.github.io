---
import type { Project } from '../data/site';
interface Props { items: Project[] }
const { items } = Astro.props;
---
<ol class="projects cycle">
  {items.map((p, i) => (
    <li>
      <a href={`/projects/${p.slug}`}>
        <div class="pc-main">
          <p class="pc-over">Featured project {i + 1}</p>
          <h3>{p.title}</h3>
          <p class="pc-sum">{p.summary}</p>
          <p class="pc-role"><b>My role:</b> {p.role}</p>
          <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
          <span class="pc-cta">Read the case study</span>
        </div>
        <ul class="pc-metrics">
          {p.metrics.map((m) => <li><b>{m.value}</b><span>{m.label}</span></li>)}
        </ul>
      </a>
    </li>
  ))}
</ol>

<style>
  .projects { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .projects a {
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 1.5rem 2.5rem;
    padding: clamp(1.4rem, 3vw, 2.2rem); border-radius: 22px; background: linear-gradient(135deg, var(--cs) 0, var(--surface) 45%);
    box-shadow: 0 0 0 1px var(--ring); color: inherit; text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .projects a:hover { box-shadow: 0 0 0 2px var(--accent), 0 24px 50px -30px rgba(11, 122, 133, 0.5); transform: translateY(-2px); }
  .pc-over { color: var(--c); font-weight: 650; font-size: 0.9rem; margin-bottom: 0.35rem; }
  h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-bottom: 0.5rem; }
  .pc-sum { color: var(--muted); }
  .pc-role { font-size: 0.95rem; }
  .pc-role b { color: var(--accent); }
  .tags { margin: 1rem 0 1.2rem; }
  .pc-cta { font-weight: 600; color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
  .pc-metrics { list-style: none; margin: 0; padding: 1.2rem 1.3rem; border-radius: 16px; background: var(--night); color: var(--night-ink); display: grid; gap: 1rem; align-content: center; }
  .pc-metrics b {
    display: block; font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 800; letter-spacing: -0.03em;
    background: linear-gradient(100deg, #5fd0d9 10%, #f5f5f7 85%); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .pc-metrics span { color: var(--night-muted); font-size: 0.85rem; }
  @media (max-width: 52rem) { .projects a { grid-template-columns: 1fr; } }
</style>
