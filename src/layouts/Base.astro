---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.headline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Experience' },
  { href: '/what-i-bring', label: 'What I bring' },
  { href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p>{site.name}, {site.role}</p>
        <ul>
          <li><a href={`mailto:${site.email}`}>Email</a></li>
          {site.linkedin && <li><a href={site.linkedin}>LinkedIn</a></li>}
          <li><a href="/contact">Get in touch</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: -999px; top: 0.5rem;
    background: var(--ink); color: var(--bg); padding: 0.5rem 1rem; z-index: 10;
  }
  .skip:focus { left: 0.5rem; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(251, 251, 253, 0.8);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .site-header, .brand, nav a { transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  :global(html.nav-dark) .site-header {
    background: rgba(22, 22, 23, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  :global(html.nav-dark) .brand,
  :global(html.nav-dark) nav a:hover { color: #f5f5f7; }
  :global(html.nav-dark) nav a { color: #a1a1a6; }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.25rem 1rem; flex-wrap: wrap; padding-top: 0.7rem; padding-bottom: 0.7rem;
  }
  .brand {
    font-family: var(--display); font-weight: 650; font-size: 1.05rem;
    color: var(--ink); text-decoration: none; letter-spacing: -0.01em;
  }
  nav ul { display: flex; gap: clamp(0.9rem, 3vw, 1.75rem); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 450; font-size: 0.875rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  @media (max-width: 30rem) {
    nav ul { gap: 0.7rem; }
    nav a { font-size: 0.8rem; }
  }
  nav a[aria-current='page'] { box-shadow: 0 2px 0 var(--accent); }

  .site-footer { border-top: 1px solid var(--line); margin-top: 2rem; }
  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    padding-top: 2rem; padding-bottom: 2.5rem; color: var(--muted); font-size: var(--step--1);
  }
  .foot p { margin: 0; }
  .foot ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
</style>
